# Valores padrão do site no Docker, usados só quando site/.env não define a variável
# (ex.: clone novo). O compose carrega este arquivo primeiro e site/.env por cima.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=troque-por-um-segredo-longo
SEED_ADMIN_NAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@localhost
