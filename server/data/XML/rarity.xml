<!--
	SISTEMA DE RARIDADE
	===================
	enabled              : 1 liga / 0 desliga o sistema (drop e evolucao)
	guaranteeMultiplier  : multiplicador de materiais quando o jogador marca "Guarantee 100% success"

	<tier>
		id         : sequencial a partir de 0 (0 = Comum, sem bonus)
		name       : nome exibido (Look, tooltip e janela Craft)
		color      : cor da borda/slot no cliente
		bonus      : % aplicado em ataque, ataque extra, defesa, defesa extra e armadura do proprio item
		dropChance : chance (em 100000) do item cair de monstro ja com essa raridade.
		             O sorteio vai do tier mais alto para o mais baixo; o primeiro que acertar vence.
		             Monstros podem ter <flag raritybonus="50"/> para +50% nessas chances.

	<group>
		name          : identificador livre
		category      : aba na janela Craft: helmet | armor | legs | boots | weapons | shields | potions | pets | others
		maxRarity     : raridade maxima que os itens do grupo podem alcancar
		drop          : 1 = pode cair de monstros com raridade / 0 = somente por evolucao
		failDowngrade : 1 = ao falhar a evolucao o item perde 1 raridade / 0 = item mantem a raridade (padrao)

		<item id="..."/> ou <item fromid="..." toid="..."/>  (itens empilhaveis sao ignorados)

		<step to="N" chance="X">  : evolucao para a raridade N, X% de sucesso (sem a garantia)
			<material id="..." count="..."/>   (quantos materiais quiser, de qualquer item)

	Um item so pode estar em um grupo. Apos editar use /reload rarity.
	Outras fontes de drop (baus, quests, bosses) podem usar doItemRollRarity(uid[, bonus]).
-->
<rarity enabled="1" guaranteeMultiplier="10">
	<tiers>
		<tier id="0" name="Common"    color="#C8C8C8" bonus="0" />
		<tier id="1" name="Uncommon"  color="#2ECC40" bonus="10" dropChance="8000" />
		<tier id="2" name="Rare"      color="#2F8CFF" bonus="20" dropChance="3000" />
		<tier id="3" name="Epic"      color="#B04BFF" bonus="30" dropChance="800" />
		<tier id="4" name="Legendary" color="#FFB000" bonus="40" dropChance="150" />
		<tier id="5" name="Mythic"    color="#FF2E2E" bonus="50" dropChance="20" />
	</tiers>

