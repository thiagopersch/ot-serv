# Copie para `.env` (mesma pasta do compose.yaml). O docker compose lê este arquivo sozinho.

# Banco (MySQL 8.4). A mesma senha vale para o site e para o servidor (config.lua lê SQL_PASS).
MYSQL_ROOT_PASSWORD=ndbo
MYSQL_DATABASE=ndbo
# Porta do MySQL publicada no host (3307 = a que site/.env e server/config.lua usam fora do Docker)
DB_PORT=3307

# Site (Next.js). NEXTAUTH_* e SEED_ADMIN_* vêm de site/.env (o mesmo do `npm run dev`);
# sem ele, valem os padrões de docker/site.defaults.env.
SITE_PORT=3000

# Servidor (TFS). SERVER_IP é o endereço que o servidor anuncia para o cliente na lista de
# personagens: 127.0.0.1 para jogar na mesma máquina; use o IP da LAN/público para outros jogadores.
SERVER_IP=127.0.0.1

# UID/GID usados pelo site e pelo servidor para escrever em ./server e ./site/public/storage.
# Windows/macOS (Docker Desktop): pode deixar 1001. Linux: use o resultado de `id -u` / `id -g`.
HOST_UID=1001
HOST_GID=1001
