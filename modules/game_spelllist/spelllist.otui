SpellListLabel < Label
  font: verdana-11px-monochrome
  background-color: alpha
  text-offset: 42 3
  focusable: true
  height: 36
  image-clip: 0 0 32 32
  image-size: 32 32
  image-offset: 2 2
  image-source: /images/game/spells/defaultspells

  $focus:
    background-color: #ffffff22
    color: #ffffff

  Button
    id: copyButton
    size: 45 20
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 50
    !text: tr('Copy')
    !tooltip: tr('Click here to copy the spell!')
    @onClick: modules.game_spelllist.copySpellWords(self:getParent():getId())

SpellInfoLabel < Label
  width: 70
  font: verdana-11px-monochrome
  text-align: right
  margin-left: 10
  margin-top: 5

SpellInfoValueLabel < Label
  text-align: left
  text-wrap: true
  text-auto-resize: true
  anchors.right: parent.right
  margin-left: 10
  margin-top: 5

FilterButton < Button
  width: 64
  anchors.left: prev.right
  anchors.top: spellList.bottom
    @onClick: modules.game_spelllist.toggleFilter(self)
  margin: 5 0 0 6
  color: #630000
  $on:
    color: green

MainWindow
  id: spelllistWindow
  !text: tr('Spell List')
  size: 900 700
  @onEscape: modules.game_spelllist.toggle()

  TextList
    id: spellList
    vertical-scrollbar: spellsScrollBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: next.top
    margin-bottom: 10
    padding: 1
    width: 210
    focusable: false

  Button
    id: buttonCancel
    !text: tr('Close')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_spelllist.toggle()

  VerticalScrollBar
    id: spellsScrollBar
    anchors.top: spellList.top
    anchors.bottom: spellList.bottom
    anchors.right: spellList.right
    step: 50
    pixels-scroll: true

  SpellInfoLabel
    id: labelName
    anchors.left: spellList.right
    anchors.top: spellList.top
    !text: tr('Name') .. ':'

  Label
    anchors.left: parent.left
    anchors.top: spellList.bottom
    !text: tr('Filters') .. ':'
    margin-top: 8

  FilterButton
    id: buttonFilterLevel
    !text: tr('Level')
    !tooltip: tr('Hide spells for higher exp. levels')



  SpellInfoValueLabel
    id: labelNameValue
    anchors.left: labelName.right
    anchors.top: labelName.top

  SpellInfoLabel
    id: labelFormula
    anchors.left: spellList.right
    anchors.top: labelNameValue.bottom
    !text: tr('Formula') .. ':'

  SpellInfoValueLabel
    id: labelFormulaValue
    anchors.left: labelFormula.right
    anchors.top: labelFormula.top

  SpellInfoLabel
    id: labelVocation
    anchors.left: spellList.right
    anchors.top: labelFormulaValue.bottom
    !text: tr('Vocation') .. ':'

  SpellInfoValueLabel
    id: labelVocationValue
    anchors.left: labelVocation.right
    anchors.top: labelVocation.top

  SpellInfoLabel
    id: labelGroup
    anchors.left: spellList.right
    anchors.top: labelVocationValue.bottom
    !text: tr('Group') .. ':'

  SpellInfoValueLabel
    id: labelGroupValue
    anchors.left: labelGroup.right
    anchors.top: labelGroup.top

  SpellInfoLabel
    id: labelType
    anchors.left: spellList.right
    anchors.top: labelGroupValue.bottom
    !text: tr('Type') .. ':'

  SpellInfoValueLabel
    id: labelTypeValue
    anchors.left: labelType.right
    anchors.top: labelType.top

  SpellInfoLabel
    id: labelCooldown
    anchors.left: spellList.right
    anchors.top: labelTypeValue.bottom
    !text: tr('Cooldown') .. ':'

  SpellInfoValueLabel
    id: labelCooldownValue
    anchors.left: labelCooldown.right
    anchors.top: labelCooldown.top

  SpellInfoLabel
    id: labelLevel
    anchors.left: spellList.right
    anchors.top: labelCooldownValue.bottom
    !text: tr('Level') .. ':'

  SpellInfoValueLabel
    id: labelLevelValue
    anchors.left: labelLevel.right
    anchors.top: labelLevel.top

  SpellInfoLabel
    id: labelMana
    anchors.left: spellList.right
    anchors.top: labelLevelValue.bottom
    !text: tr('Mana') .. ' / ' .. tr('Soul') .. ':'

  SpellInfoValueLabel
    id: labelManaValue
    anchors.left: labelMana.right
    anchors.top: labelMana.top

  SpellInfoLabel
    id: labelPremium
    anchors.left: spellList.right
    anchors.top: labelManaValue.bottom
    !text: tr('Premium') .. ':'

  SpellInfoValueLabel
    id: labelPremiumValue
    anchors.left: labelPremium.right
    anchors.top: labelPremium.top

  SpellInfoLabel
    id: labelDescription
    anchors.left: spellList.right
    anchors.top: labelPremiumValue.bottom
    !text: tr('Description') .. ':'

  SpellInfoValueLabel
    id: labelDescriptionValue
    anchors.left: labelDescription.right
    anchors.top: labelDescription.top

  Label
    id: labelGroupFilter
    anchors.top: labelDescriptionValue.bottom
    anchors.left: spellList.right
    width: 200
    font: verdana-11px-monochrome
    !text: tr('Spell Groups Filter')
    text-align: center
    margin-top: 25
    margin-left: 50

  CheckBox
    id: groupBoxAny
    anchors.left: spellList.right
    anchors.top: prev.bottom
    margin-top: 10
    margin-left: 20
    !text: tr('All')
    width: 75

  CheckBox
    id: groupBoxAttacks
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 5
    !text: tr('Attacks')
    width: 75

  CheckBox
    id: groupBoxDefenses
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 5
    !text: tr('Defenses')
    width: 75

  CheckBox
    id: groupBoxHealings
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 5
    !text: tr('Healings')
    width: 75

  CheckBox
    id: groupBoxBuffs
    anchors.left: groupBoxAny.right
    anchors.top: groupBoxAny.top
    margin-left: 20
    !text: tr('Buffs')
    width: 75

  CheckBox
    id: groupBoxSuporte
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 5
    !text: tr('Suporte')
    width: 75

  CheckBox
    id: groupBoxEspecial
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 5
    !text: tr('Especial')
    width: 75

  CheckBox
    id: groupBoxCombos
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 5
    !text: tr('Combos')
    width: 75
