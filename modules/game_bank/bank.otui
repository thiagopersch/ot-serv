TextPanel < Panel
  size: 90 20
  font: verdana-11px-rounded
  text-align: center
  text-offset: 0 2
  color: #00df00
  opacity: 1.0
  border-width: 1
  border-color: black

Window
  id: mainWindow
  !text: tr('Bank')
  size: 480 170
  anchors.centerIn: parent
  padding: 2
  @onEscape: modules.game_bank.close()

  VerticalSeparator
    id: separator
    height: 100
    anchors.centerIn: parent

  TextPanel
    id: inventoryBalanceText
    height: 20
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    anchors.right: separator.left
    margin-left: 15
    margin-right: 15
    phantom: false

  Label
    !text: tr('Inventory Balance') .. ':'
    font: sans-bold-16px
    text-align: center
    text-auto-resize: true
    color: #d0d0d0
    anchors.left: inventoryBalanceText.left
    anchors.bottom: inventoryBalanceText.top
    margin-bottom: 10

  Button
    !text: tr('Deposit')
    anchors.left: inventoryBalanceText.left
    anchors.top: inventoryBalanceText.bottom
    color: #ffffff
    width: 95
    margin-top: 10
    @onClick: modules.game_bank.deposit()

  Button
    !text: tr('Deposit all')
    anchors.right: inventoryBalanceText.right
    anchors.top: inventoryBalanceText.bottom
    color: #ffffff
    width: 95
    margin-top: 10
    @onClick: modules.game_bank.depositAll()

  TextPanel
    id: bankBalanceText
    height: 20
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    anchors.left: separator.right
    margin-left: 15
    margin-right: 15
    phantom: false

  Label
    font: sans-bold-16px
    !text: tr('Bank Balance') .. ':'
    text-align: center
    text-auto-resize: true
    color: #d0d0d0
    anchors.left: bankBalanceText.left
    anchors.bottom: bankBalanceText.top
    margin-bottom: 10

  Button
    !text: tr('Withdraw')
    anchors.left: bankBalanceText.left
    anchors.top: bankBalanceText.bottom
    color: #ffffff
    width: 95
    margin-top: 10
    @onClick: modules.game_bank.withdraw()

  Button
    !text: tr('Withdraw all')
    anchors.right: bankBalanceText.right
    anchors.top: bankBalanceText.bottom
    color: #ffffff
    width: 95
    margin-top: 10
    @onClick: modules.game_bank.withdrawAll()

  Panel
    id: errorMessagePanel
    font: verdana-11px-rounded
    text-align: center
    text-auto-resize: true
    text-offset: 0 1
    color: red
    border-width: 1
    border-color: #191919
    anchors.top: separator.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 15
    margin-right: 15
    margin-top: 4
    margin-bottom: 7

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 4
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14
    $hover:
      image-clip: 28 14 14 14
    $pressed:
      image-clip: 28 28 14 14
    @onClick: modules.game_bank.close()
