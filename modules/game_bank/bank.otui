Window
  id: bankWindow
  !text: tr('Bank System')
  size: 580 420
  anchors.centerIn: parent
  visible: false
  @onEscape: modules.game_bank.toggle()

  Button
    id: closeBtn
    size: 24 24
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 4 4 0 0
    image-color: #cc0000
    color: #ffffff
    !text: 'X'
    @onClick: modules.game_bank.toggle()

  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeBottomBtn.top
    margin: 40 10 10 10
    background-color: #222222aa
    border: 1 #444444

    Panel
      id: separator
      anchors.top: parent.top
      anchors.bottom: transferPanel.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      margin-bottom: 10
      width: 1
      background-color: #444444

    Label
      id: inventoryTitle
      !text: tr('Inventory Balance:')
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: separator.left
      margin: 15 10 0 10
      font: sans-bold-16px
      color: #cccccc
      text-align: center

    Panel
      id: inventoryBox
      anchors.top: inventoryTitle.bottom
      anchors.left: parent.left
      anchors.right: separator.left
      margin: 10 10 0 10
      height: 30
      background-color: #111111
      border: 1 #444444

      Label
        id: inventoryTotalValue
        anchors.centerIn: parent
        font: verdana-11px-rounded
        color: #00ff00
        text-auto-resize: true
        !text: '$0'

    Button
      id: depositBtn
      anchors.top: inventoryBox.bottom
      anchors.left: inventoryBox.left
      margin-top: 10
      size: 110 28
      !text: tr('Deposit')

    Button
      id: depositAllBtn
      anchors.top: inventoryBox.bottom
      anchors.left: depositBtn.right
      anchors.right: inventoryBox.right
      margin-top: 10
      margin-left: 10
      height: 28
      !text: tr('Deposit all')

    Label
      id: bankTitle
      !text: tr('Bank Balance:')
      anchors.top: parent.top
      anchors.left: separator.right
      anchors.right: parent.right
      margin: 15 10 0 10
      font: sans-bold-16px
      color: #cccccc
      text-align: center

    Panel
      id: bankBox
      anchors.top: bankTitle.bottom
      anchors.left: separator.right
      anchors.right: parent.right
      margin: 10 10 0 10
      height: 30
      background-color: #111111
      border: 1 #444444

      Label
        id: balanceValue
        anchors.centerIn: parent
        font: verdana-11px-rounded
        color: #00ff00
        text-auto-resize: true
        !text: '$0'

    Button
      id: withdrawBtn
      anchors.top: bankBox.bottom
      anchors.left: bankBox.left
      margin-top: 10
      size: 110 28
      !text: tr('Withdraw')

    Button
      id: withdrawAllBtn
      anchors.top: bankBox.bottom
      anchors.left: withdrawBtn.right
      anchors.right: bankBox.right
      margin-top: 10
      margin-left: 10
      height: 28
      !text: tr('Withdraw all')

    Panel
      id: transferPanel
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 10
      height: 50
      border: 1 #444444

      Button
        id: transferBtn
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        anchors.right: parent.horizontalCenter
        margin-left: 10
        margin-right: 5
        height: 28
        !text: tr('Transfer')
        !tooltip: tr('Transfer money to a player')

      Button
        id: transferAllBtn
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.horizontalCenter
        anchors.right: parent.right
        margin-left: 5
        margin-right: 10
        height: 28
        !text: tr('Transfer All')
        !tooltip: tr('Transfer all your money to a player')

  Button
    id: closeBottomBtn
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 10
    size: 150 24
    !text: tr('Close')
    image-color: #cc0000
    color: #ffffff
    @onClick: modules.game_bank.toggle()
