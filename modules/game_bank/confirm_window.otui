Window
  id: mainWindow
  !text: tr('Confirm')
  size: 250 180
  anchors.centerIn: parent
  padding: 2
  @onEscape: modules.game_bank.close()

  Label
    id: windowTitle
    font: sans-bold-16px
    text-auto-resize: true
    color: #d0d0d0
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 30

  TextEdit
    id: valueInput
    height: 20
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 15
    margin-right: 15
    max-length: 10
    @onSetup: self:setValidCharacters('0123456789')

  Label
    id: inputValueLabel
    font: verdana-11px-rounded
    text-auto-resize: true
    color: white
    anchors.left: valueInput.left
    anchors.top: valueInput.bottom
    margin-top: 2

  Label
    id: balanceLabel
    font: verdana-11px-rounded
    text-auto-resize: true
    color: #d0d0d0
    anchors.horizontalCenter: valueInput.horizontalCenter
    anchors.bottom: valueInput.top

  Button
    id: confirmButton
    !text: tr('Confirm')
    anchors.left: valueInput.left
    anchors.bottom: parent.bottom
    color: #ffffff
    size: 70 30
    margin-bottom: 12
    margin-left: 10
    @onClick: modules.game_bank.confirm()

  Button
    id: cancelButton
    !text: tr('Cancel')
    anchors.right: valueInput.right
    anchors.bottom: confirmButton.bottom
    color: #ffffff
    size: 70 30
    margin-right: 10
    @onClick: modules.game_bank.closeConfirm()
