MainWindow
  id: vocationRanksWindow
  !text: tr('Vocation Ranks')
  size: 320 320
  @onEscape: hideWindow()

  Label
    id: rankLabel
    !text: tr('Rank: Bronze 0/5')
    text-align: center
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    font: verdana-11px-rounded

  ProgressBar
    id: starsBar
    height: 20
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    maximum: 5
    minimum: 0
    value: 0

  Label
    id: infoLabel
    !text: tr('Bonus per Star:\nAttack: +5 | Defense: +3\nHealth: +100 | Mana: +50')
    text-align: center
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 15
    font: verdana-11px-rounded

  Label
    id: fragmentsLabel
    !text: tr('Fragments:\nUniversal: 0/100\nSpecific: 0/100')
    text-align: center
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 15
    font: verdana-11px-rounded

  Button
    id: upgradeBtn
    !text: tr('Upgrade')
    anchors.bottom: statusLabel.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 5
    @onClick: onUpgrade()

  Label
    id: statusLabel
    text:
    color: #ff5555
    text-align: center
    text-auto-resize: true
    anchors.bottom: closeBtn.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 5
    font: verdana-11px-rounded

  Button
    id: closeBtn
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 64
    @onClick: hideWindow()
