    DailyItemPanel
      id: panel26
      @onSetup: self:getChildById("labelWidget"):setText("26")
    DailyItemPanel
      id: panel27
      @onSetup: self:getChildById("labelWidget"):setText("27")
    DailyItemPanel
      id: panel28
      @onSetup: self:getChildById("labelWidget"):setText("28")

  Label
    !text: '3 ' .. tr('DIAS EM FILA')
    font: terminus-14px-bold
    text-auto-resize: true
    color: white
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 50
    margin-right: 45
  DailySeqItemPanel
    id: seq3Panel
    anchors.top: prev.bottom
    anchors.horizontalCenter: prev.horizontalCenter
    size: 38 38

  Label
    !text: '7 ' .. tr('DIAS EM FILA')
    font: terminus-14px-bold
    text-auto-resize: true
    color: white
    anchors.top: prev.bottom
    anchors.horizontalCenter: prev.horizontalCenter
    margin-top: 20
  DailySeqItemPanel
    id: seq7Panel
    anchors.top: prev.bottom
    anchors.horizontalCenter: prev.horizontalCenter
    size: 38 38

  Label
    !text: '25 ' .. tr('DIAS EM FILA')
    font: terminus-14px-bold
    text-auto-resize: true
    color: white
    anchors.top: prev.bottom
    anchors.horizontalCenter: prev.horizontalCenter
    margin-top: 20
  DailySeqItemPanel
    id: seq25Panel
    size: 38 38
    anchors.top: prev.bottom
    anchors.horizontalCenter: prev.horizontalCenter

  Label
    id: sequenceLabel
    font: verdana-11px-rounded
    text-auto-resize: true
    color: white
    anchors.horizontalCenter: daysPanel.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 20

  UIButton
    id: closeButton
    image-source: assets/close_button
    anchors.top: parent.top
    anchors.right: parent.right
    size: 34 22
    opacity: 1.0
    margin-top: 2
    margin-right: 6
    change-cursor-image: true
    cursor: pointer
    $pressed:
      opacity: 0.7
    @onClick: modules.game_daily.close()

  @onEscape: modules.game_daily.close()
