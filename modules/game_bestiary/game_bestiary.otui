// ── Botão de aba ──────────────────────────────────────────────────────────
BestiaryTabButton < UIButton
  size: 100 28
  color: #aaaaaa
  text-align: center
  font: verdana-11px-rounded
  background-color: #333333
  border-width: 1
  border-color: #555555
  $checked:
    background-color: #555555
    border-color: #888888
    color: white
  $hover !checked:
    background-color: #3e3e3e

// ── Botão de seta de paginação ────────────────────────────────────────────
BestiaryArrowButton < UIButton
  size: 28 24
  color: #cccccc
  text-align: center
  font: verdana-11px-rounded
  background-color: #333333
  border-width: 1
  border-color: #555555
  $hover:
    background-color: #444444
  $disabled:
    color: #555555
    background-color: #282828

// ── Janela principal ───────────────────────────────────────────────────────
MainWindow
  id: bestiaryWindow
  !text: tr('Bestiary')
  size: 860 640
  min-size: 700 500
  resizable: false
  @onClose: modules.game_bestiary.onWindowClose()

  Panel
    id: mainContainer
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 4

    // ── Barra superior ─────────────────────────────────────────────────
    Panel
      id: topBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 36

      BestiaryTabButton
        id: tabMonsters
        !text: tr('Monsters')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        checked: true
        @onClick: modules.game_bestiary.onTabClick('monsters')

      BestiaryTabButton
        id: tabBosses
        !text: tr('Bosses')
        anchors.left: tabMonsters.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        @onClick: modules.game_bestiary.onTabClick('bosses')

      TextEdit
        id: searchField
        anchors.left: tabBosses.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 10
        height: 24
        !placeholder: tr('Search monster...')
        @onTextChange: modules.game_bestiary.onSearchChange(self)

    // ── Paginação (declarada antes do leftPanel para o anchor resolver) ─
    Panel
      id: paginationBar
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 560
      height: 28

      BestiaryArrowButton
        id: prevPageBtn
        !text: '<'
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        @onClick: modules.game_bestiary.onPrevPage()

      Label
        id: pageLabel
        !text: tr('Page 1 of 1')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        text-align: center
        width: 180
        color: #cccccc

      BestiaryArrowButton
        id: nextPageBtn
        !text: '>'
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        @onClick: modules.game_bestiary.onNextPage()

    // ── Painel esquerdo: grid de criaturas ────────────────────────────
    Panel
      id: leftPanel
      anchors.top: topBar.bottom
      anchors.bottom: paginationBar.top
      anchors.left: parent.left
      width: 560
      margin-top: 6

      ScrollablePanel
        id: scrollPanel
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        vertical-scrollbar: scrollBar

        Panel
          id: gridPanel
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          layout:
            type: grid
            num-columns: 5
            cell-size: 104 120
            cell-spacing: 4
            fit-children: true

      VerticalScrollBar
        id: scrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 14
        pixels-scroll: true

    // ── Painel direito: detalhes da criatura ──────────────────────────
    Panel
      id: detailPanel
      anchors.top: topBar.bottom
      anchors.bottom: parent.bottom
      anchors.left: leftPanel.right
      anchors.right: parent.right
      margin-top: 6
      margin-left: 4
      visible: false

      ScrollablePanel
        id: detailScroll
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        vertical-scrollbar: detailScrollBar

        // detailContent usa anchor layout (sem layout: definido)
        // Cada filho ancora no anterior — altura definida por Lua
        Panel
          id: detailContent
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right

          UICreature
            id: detailSprite
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            margin-top: 8
            size: 80 80

          Label
            id: detailName
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: detailSprite.bottom
            margin-top: 4
            color: white
            text-align: center
            width: 220
            height: 18

          UIProgressBar
            id: detailProgress
            anchors.top: detailName.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 6
            margin-left: 8
            margin-right: 8
            height: 14

          Label
            id: detailProgressLabel
            !text: '0 / 0'
            anchors.top: detailProgress.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 2
            color: #aaaaaa
            text-align: center
            width: 180
            height: 14
            font: verdana-9px

          Label
            id: statsHeader
            !text: tr('Statistics')
            anchors.top: detailProgressLabel.bottom
            anchors.left: parent.left
            margin-top: 10
            margin-left: 8
            color: #ffcc44
            font: verdana-11px-rounded
            width: 200
            height: 18

          // statGrid: grid layout — filhos NÃO usam anchors
          Panel
            id: statGrid
            anchors.top: statsHeader.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 2
            margin-left: 8
            margin-right: 8
            layout:
              type: grid
              num-columns: 2
              cell-size: 107 16
              fit-children: true

            Label
              id: statHealthLbl
              !text: 'Health:'
              color: #aaaaaa
              height: 16

            Label
              id: statHealthValue
              !text: '0'
              color: white
              text-align: right
              height: 16

            Label
              id: statExpLbl
              !text: 'Experience:'
              color: #aaaaaa
              height: 16

            Label
              id: statExpValue
              !text: '0'
              color: white
              text-align: right
              height: 16

            Label
              id: statSpeedLbl
              !text: 'Speed:'
              color: #aaaaaa
              height: 16

            Label
              id: statSpeedValue
              !text: '0'
              color: white
              text-align: right
              height: 16

            Label
              id: statArmorLbl
              !text: 'Armor:'
              color: #aaaaaa
              height: 16

            Label
              id: statArmorValue
              !text: '0'
              color: white
              text-align: right
              height: 16

          Label
            id: resistHeader
            !text: tr('Resistances')
            anchors.top: statGrid.bottom
            anchors.left: parent.left
            margin-top: 10
            margin-left: 8
            color: #ffcc44
            font: verdana-11px-rounded
            width: 200
            height: 18

          // resistPanel: verticalBox — BestiaryResistBar adicionados por Lua
          // Os bars em si usam anchor layout internamente (OK)
          Panel
            id: resistPanel
            anchors.top: resistHeader.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 2
            margin-left: 8
            margin-right: 8
            layout:
              type: verticalBox
              fit-children: true
              spacing: 2

          Label
            id: lootHeader
            !text: tr('Loot')
            anchors.top: resistPanel.bottom
            anchors.left: parent.left
            margin-top: 10
            margin-left: 8
            color: #ffcc44
            font: verdana-11px-rounded
            width: 200
            height: 18

          // lootPanel: verticalBox — BestiaryLootCategory adicionados por Lua
          Panel
            id: lootPanel
            anchors.top: lootHeader.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 2
            margin-left: 8
            margin-right: 8
            layout:
              type: verticalBox
              fit-children: true
              spacing: 4

      VerticalScrollBar
        id: detailScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 14
        pixels-scroll: true

// ── Card da criatura no grid ──────────────────────────────────────────────
// Usa anchor layout internamente
BestiaryCard < Panel
  size: 104 120
  background-color: #252525
  border-width: 1
  border-color: #404040
  $checked:
    background-color: #3a3a3a
    border-color: #7777ff
  $hover !checked:
    background-color: #303030
  @onMouseRelease: modules.game_bestiary.onCardClick(self)
  @onMouseEnter: modules.game_bestiary.onCardHover(self, true)
  @onMouseLeave: modules.game_bestiary.onCardHover(self, false)

  UICreature
    id: icon
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 8
    size: 64 64

  Label
    id: nameLabel
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 6
    font: verdana-9px
    color: #cccccc
    text-align: center
    width: 98

// ── Barra de resistência ──────────────────────────────────────────────────
// Usa anchor layout internamente (sem layout: definido)
BestiaryResistBar < Panel
  height: 16

  Label
    id: label
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 68
    color: #aaaaaa
    text-align: left

  Panel
    id: track
    anchors.left: label.right
    anchors.right: valueLabel.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 4
    background-color: #333333

    Panel
      id: fill
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 0

  Label
    id: valueLabel
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 36
    color: white
    text-align: right

// ── Categoria de loot ─────────────────────────────────────────────────────
// Usa anchor layout internamente (sem layout: definido)
// Altura total definida por Lua após popular os items
BestiaryLootCategory < Panel

  Label
    id: rarityLabel
    anchors.left: parent.left
    anchors.top: parent.top
    width: 80
    height: 18
    color: white
    text-align: left
    font: verdana-9px

  // itemsPanel: grid layout — BestiaryItemSlot filhos NÃO usam anchors (correto)
  Panel
    id: itemsPanel
    anchors.top: rarityLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    layout:
      type: grid
      num-columns: 6
      cell-size: 34 34
      cell-spacing: 2
      fit-children: true

