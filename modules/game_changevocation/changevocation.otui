MainWindow
  id: mainWindow
  !text: tr("Change Vocation")
  size: 500 340
  color: white
  font: verdana-11px-rounded
  padding-top: 30
  padding-bottom: 10
  @onEscape: modules.game_changevocation.close()

  VerticalSeparator
    id: separator
    anchors.top: parent.top
    anchors.bottom: bottomSeparator.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-right: 50
    margin-bottom: 5

  Panel
    id: infoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: separator.left
    anchors.bottom: upgradeButton.top
    background-color: #0000007f
    border-width: 1
    border-color: black
    border-color-right: #7b7b7b
    border-color-bottom: #7b7b7b
    margin-right: 5
    margin-bottom: 5
    Label
      id: nameLabel
      text-vertical-auto-resize: true
      text-wrap: true
      text-align: center
      color: white
      width: 160
      font: terminus-14px-bold
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
    Panel
      id: starsPanel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 40
      phantom: true
      layout:
        type: grid
        flow: true
        cell-size: 9 10
        cell-spacing: 5
    Panel
      id: vocationPanel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 60
    Label
      id: infoLabel
      text-vertical-auto-resize: true
      text-wrap: true
      width: 170
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 20
      margin-left: 8

  TextEdit
    id: searchVocationText
    !placeholder: tr("Search")
    placeholder-color: #2929299f
    max-length: 12
    width: 120
    icon: /images/ui/search
    icon-align: left
    icon-size: 14 14
    icon-offset: 4 4
    padding-left: 22
    anchors.top: parent.top
    anchors.left: separator.right
    margin-left: 5

  Label
    id: countLabel
    text-auto-resize: true
    font: verdana-11px-rounded
    color: white
    anchors.left: searchVocationText.right
    anchors.verticalCenter: searchVocationText.verticalCenter
    margin-left: 5

  Button
    id: filtersButton
    width: 70
    anchors.right: parent.right
    anchors.verticalCenter: searchVocationText.verticalCenter
    &onClick: modules.game_changevocation.onClickFiltersButton

  ScrollablePanel
    id: vocationsList
    anchors.top: searchVocationText.bottom
    anchors.bottom: separator.bottom
    anchors.right: parent.right
    anchors.left: searchVocationText.left
    margin-top: 3
    background-color: #202020
    border-width: 1
    border-color: black
    border-color-right: #7b7b7b
    border-color-bottom: #7b7b7b
    padding: 1
    vertical-scrollbar: vocationsScrollBar
    layout:
      type: grid
      cell-size: 64 64
      cell-spacing: 2
      flow: true

  VerticalScrollBar
    id: vocationsScrollBar
    anchors.top: vocationsList.top
    anchors.bottom: vocationsList.bottom
    anchors.right: vocationsList.right
    margin-left: 8
    step: 30
    pixels-scroll: true

  Button
    id: confirmButton
    !text: tr("Confirm")
    width: 70
    anchors.left: parent.left
    anchors.bottom: separator.bottom
    @onClick: modules.game_changevocation.confirm()

  Button
    id: upgradeButton
    !text: tr("Upgrade")
    width: 70
    anchors.right: separator.left
    anchors.bottom: separator.bottom
    margin-right: 5
    @onClick: modules.game_changevocation.upgrade()

  HorizontalSeparator
    id: bottomSeparator
    anchors.bottom: closeButton.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-bottom: 5

  Button
    id: closeButton
    !text: tr("Close")
    width: 56
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_changevocation.close()
