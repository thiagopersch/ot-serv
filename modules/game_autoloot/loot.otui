// Grade fixa de 6 colunas: 6 * 38 + 5 * 6 = 258px. A scrollbar fica ancorada na borda direita
// do painel, então sempre sobra um respiro entre o último slot e ela.
AutolootItemSlot < UIItem
  size: 38 38
  padding: 3
  background-color: #101214
  border-width: 1
  border-color: #45494f
  virtual: true
  focusable: true

  $hover:
    border-color: #6faaff

AutolootGrid < UIScrollArea
  width: 258
  layout:
    type: grid
    cell-size: 38 38
    cell-spacing: 6
    num-columns: 6

AutolootPanelTitle < Label
  font: verdana-11px-rounded
  color: #ffcc00
  text-auto-resize: true

MainWindow
  id: gw_AutoLoot
  size: 640 480
  !text: tr('Autoloot')
  @onEscape: toggle()

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: closeButton.left
    text-align: center
    font: terminus-14px-bold
    color: #ffcc00
    text: Autoloot

  Button
    id: closeButton
    !text: tr('Close')
    anchors.top: parent.top
    anchors.right: parent.right
    width: 60
    image-color: #cc3333
    @onClick: toggle()

  CheckBox
    id: moneyCheckbox
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    margin-top: 10

    @onClick: modules.game_autoloot.toggleMoney()

  Label
    id: moneyLabel
    anchors.verticalCenter: moneyCheckbox.verticalCenter
    anchors.left: moneyCheckbox.right
    margin-left: 6
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true
    !text: tr('Collect money')

  Label
    id: slotsLabel
    anchors.top: closeButton.bottom
    anchors.right: parent.right
    margin-top: 4
    font: verdana-11px-rounded
    color: #9a9a9a
    text-align: right
    text-auto-resize: true
    text: 0/30

  Panel
    id: leftPanel
    anchors.top: moneyCheckbox.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-bottom: 6
    width: 300
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 6

    AutolootPanelTitle
      id: leftTitle
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Available items')

    ComboBox
      id: categoryCombo
      anchors.top: leftTitle.bottom
      anchors.right: parent.right
      margin-top: 4
      size: 104 22
      !tooltip: tr('Filter by type')

    TextEdit
      id: searchEdit
      anchors.top: categoryCombo.top
      anchors.left: parent.left
      anchors.right: categoryCombo.left
      margin-right: 4
      !tooltip: tr('Search by name')
      !placeholder: tr('Search item...')

    AutolootGrid
      id: leftGrid
      anchors.top: searchEdit.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 6
      vertical-scrollbar: leftScrollBar

    VerticalScrollBar
      id: leftScrollBar
      anchors.top: leftGrid.top
      anchors.bottom: leftGrid.bottom
      anchors.right: parent.right
      // uma linha da grade por tick (cell 38 + spacing 6); o default é 1px
      step: 44

  Panel
    id: rightPanel
    anchors.top: moneyCheckbox.bottom
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-bottom: 6
    width: 300
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 6

    Button
      id: clearAllButton
      !text: tr('Clear items')
      anchors.top: parent.top
      anchors.right: parent.right
      width: 80
      @onClick: modules.game_autoloot.clearAll()

    AutolootPanelTitle
      id: rightTitle
      anchors.verticalCenter: clearAllButton.verticalCenter
      anchors.left: parent.left
      !text: tr('Autoloot items (click to remove)')

    AutolootGrid
      id: rightGrid
      anchors.top: clearAllButton.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 6
      vertical-scrollbar: rightScrollBar

    VerticalScrollBar
      id: rightScrollBar
      anchors.top: rightGrid.top
      anchors.bottom: rightGrid.bottom
      anchors.right: parent.right
      step: 44
