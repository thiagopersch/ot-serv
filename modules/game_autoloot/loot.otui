AutolootItemSlot < UIItem
  size: 34 34
  border-width: 1
  border-color: #55555588
  virtual: true
  focusable: true

  $hover:
    border-color: #ffffff88

MainWindow
  id: gw_AutoLoot
  size: 620 480
  !text: tr('Autoloot')
  @onEscape: toggle()

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: closeButton.left
    text-align: center
    font: verdana-11px-monochrome
    color: #ffd700
    text: Autoloot

  Button
    id: closeButton
    !text: tr('Close')
    anchors.top: parent.top
    anchors.right: parent.right
    width: 60
    image-color: #cc3333
    @onClick: toggle()

  CheckBox
    id: moneyCheckbox
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    margin-top: 8
    !text: tr('Collect money')
    @onClick: modules.game_autoloot.toggleMoney()

  Label
    id: slotsLabel
    anchors.top: moneyCheckbox.top
    anchors.right: parent.right
    font: verdana-11px-monochrome
    text: 0/30

  Panel
    id: leftPanel
    anchors.top: moneyCheckbox.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-bottom: 6
    width: 290

    Label
      id: leftTitle
      anchors.top: parent.top
      anchors.left: parent.left
      font: verdana-11px-monochrome
      color: #88aaff
      text: Available items

    TextEdit
      id: searchEdit
      anchors.top: leftTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      !tooltip: tr('Search by name')

    UIScrollArea
      id: leftGrid
      anchors.top: searchEdit.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      vertical-scrollbar: leftScrollBar
      layout:
        type: grid
        cell-size: 36 36
        cell-spacing: 2

    VerticalScrollBar
      id: leftScrollBar
      anchors.top: leftGrid.top
      anchors.bottom: leftGrid.bottom
      anchors.right: parent.right

  Panel
    id: rightPanel
    anchors.top: moneyCheckbox.bottom
    anchors.left: leftPanel.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-bottom: 6
    margin-left: 10

    Label
      id: rightTitle
      anchors.top: parent.top
      anchors.left: parent.left
      font: verdana-11px-monochrome
      color: #88aaff
      text: Being collected (click to remove)

    UIScrollArea
      id: rightGrid
      anchors.top: rightTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      vertical-scrollbar: rightScrollBar
      layout:
        type: grid
        cell-size: 36 36
        cell-spacing: 2

    VerticalScrollBar
      id: rightScrollBar
      anchors.top: rightGrid.top
      anchors.bottom: rightGrid.bottom
      anchors.right: parent.right
