AutolootItemSlot < UIItem
  size: 34 34
  background-color: #101214
  border-width: 1
  border-color: #45494f
  virtual: true
  focusable: true

  $hover:
    border-color: #6faaff

MainWindow
  id: gw_AutoLoot
  size: 620 480
  !text: tr('Autoloot')
  @onEscape: toggle()

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: closeButton.left
    text-align: center
    font: terminus-14px-bold
    color: #ffcc00
    text: Autoloot

  Button
    id: closeButton
    !text: tr('Close')
    anchors.top: parent.top
    anchors.right: parent.right
    width: 60
    image-color: #cc3333
    @onClick: toggle()

  CheckBox
    id: moneyCheckbox
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    margin-top: 10

    @onClick: modules.game_autoloot.toggleMoney()

  Label
    id: moneyLabel
    anchors.verticalCenter: moneyCheckbox.verticalCenter
    anchors.left: moneyCheckbox.right
    margin-left: 6
    font: verdana-9px
    color: #dfdfdf
    !text: tr('Collect money')

  Label
    id: slotsLabel
    anchors.top: moneyCheckbox.top
    anchors.right: parent.right
    font: verdana-9px
    color: #9a9a9a
    text: 0/30

  Panel
    id: leftPanel
    anchors.top: moneyCheckbox.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-bottom: 6
    width: 290
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 6

    Label
      id: leftTitle
      anchors.top: parent.top
      anchors.left: parent.left
      font: verdana-9px
      color: #ffcc00
      text: Available items

    TextEdit
      id: searchEdit
      anchors.top: leftTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      !tooltip: tr('Search by name')
      !placeholder: tr('Search item...')

    UIScrollArea
      id: leftGrid
      anchors.top: searchEdit.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      vertical-scrollbar: leftScrollBar
      layout:
        type: grid
        cell-size: 36 36
        cell-spacing: 2
        num-columns: 7

    VerticalScrollBar
      id: leftScrollBar
      anchors.top: leftGrid.top
      anchors.bottom: leftGrid.bottom
      anchors.right: parent.right

  Panel
    id: rightPanel
    anchors.top: moneyCheckbox.bottom
    anchors.left: leftPanel.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-bottom: 6
    margin-left: 10
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 6

    Label
      id: rightTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: clearAllButton.left
      font: verdana-9px
      color: #ffcc00
      text: Autoloot items (click to remove)

    Button
      id: clearAllButton
      !text: tr('Clear items')
      anchors.top: parent.top
      anchors.right: parent.right
      width: 70
      @onClick: modules.game_autoloot.clearAll()

    UIScrollArea
      id: rightGrid
      anchors.top: rightTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      vertical-scrollbar: rightScrollBar
      layout:
        type: grid
        cell-size: 36 36
        cell-spacing: 2
        num-columns: 7

    VerticalScrollBar
      id: rightScrollBar
      anchors.top: rightGrid.top
      anchors.bottom: rightGrid.bottom
      anchors.right: parent.right
