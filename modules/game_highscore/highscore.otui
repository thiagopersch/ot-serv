HighscoreRow < Panel
  height: 56
  padding: 2
  background-color: alpha

  $hover:
    background-color: #ffffff11

  UICreature
    id: outfit
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 48 48
    fixed-creature-size: true

  Label
    id: rankLabel
    anchors.left: outfit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    width: 40
    color: #dfdfdf
    font: verdana-11px-monochrome

  Label
    id: nameLabel
    anchors.left: rankLabel.right
    anchors.verticalCenter: parent.verticalCenter
    width: 200
    color: #dfdfdf
    font: verdana-11px-monochrome

  Label
    id: levelLabel
    anchors.left: nameLabel.right
    anchors.verticalCenter: parent.verticalCenter
    width: 60
    color: #dfdfdf
    font: verdana-11px-monochrome

  Label
    id: vocLabel
    anchors.left: levelLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    color: #dfdfdf
    font: verdana-11px-monochrome

HighscoreHeaderRow < Panel
  height: 20
  padding: 2

  UIWidget
    id: outfitHeaderSpacer
    anchors.left: parent.left
    size: 48 1

  Label
    id: rankHeader
    anchors.left: outfitHeaderSpacer.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    width: 40
    color: #aaaaaa
    font: verdana-11px-monochrome
    text: Rank

  Label
    id: nameHeader
    anchors.left: rankHeader.right
    anchors.verticalCenter: parent.verticalCenter
    width: 200
    color: #aaaaaa
    font: verdana-11px-monochrome
    text: Name

  Label
    id: levelHeader
    anchors.left: nameHeader.right
    anchors.verticalCenter: parent.verticalCenter
    width: 60
    color: #aaaaaa
    font: verdana-11px-monochrome
    text: Level

  Label
    id: vocHeader
    anchors.left: levelHeader.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    color: #aaaaaa
    font: verdana-11px-monochrome
    text: Vocation

MainWindow
  id: highscoreWindow
  !text: tr('Highscores')
  size: 620 560
  @onEscape: modules.game_highscore.toggle()

  Label
    id: categoryLabel
    anchors.top: parent.top
    anchors.left: parent.left
    !text: tr('Rank by:')
    font: verdana-11px-monochrome
    color: #dfdfdf

  ComboBox
    id: categoryCombo
    anchors.verticalCenter: categoryLabel.verticalCenter
    anchors.left: categoryLabel.right
    margin-left: 8
    width: 170

  Label
    id: titleLabel
    anchors.verticalCenter: categoryCombo.verticalCenter
    anchors.left: categoryCombo.right
    anchors.right: closeButton.left
    margin-left: 10
    text-align: left
    font: verdana-11px-monochrome
    color: #ffd700
    text: Level

  HighscoreHeaderRow
    id: headerRow
    anchors.top: categoryCombo.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  UIScrollArea
    id: resultList
    anchors.top: headerRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: pagePanel.top
    margin-top: 4
    margin-bottom: 6
    margin-right: 12
    padding: 1
    focusable: false
    vertical-scrollbar: resultScrollBar
    layout:
      type: verticalBox
      spacing: 1

  VerticalScrollBar
    id: resultScrollBar
    anchors.top: resultList.top
    anchors.right: parent.right
    anchors.bottom: resultList.bottom
    step: 28
    pixel-scroll: true

  Panel
    id: pagePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26

    Button
      id: prevPageButton
      anchors.left: parent.left
      width: 64
      !text: tr('Previous')
      @onClick: modules.game_highscore.previousPage()

    Label
      id: pageLabel
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      text: Page 1 / 1
      font: verdana-11px-monochrome

    Button
      id: nextPageButton
      anchors.right: parent.right
      width: 64
      !text: tr('Next')
      @onClick: modules.game_highscore.nextPage()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.top: parent.top
    anchors.right: parent.right
    width: 60
    image-color: #cc3333
    @onClick: modules.game_highscore.toggle()
