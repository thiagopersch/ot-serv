HighscoreCategoryButton < Button
  width: 150
  height: 24
  text-align: left
  $on:
    color: #55ff55

HighscoreRow < Panel
  height: 28
  padding: 2
  background-color: alpha

  $hover:
    background-color: #ffffff11

  UICreature
    id: outfit
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 24 24
    fixed-creature-size: true

  Label
    id: rankLabel
    anchors.left: outfit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 30
    color: #dfdfdf
    font: verdana-11px-monochrome

  Label
    id: nameLabel
    anchors.left: rankLabel.right
    anchors.verticalCenter: parent.verticalCenter
    width: 220
    color: #dfdfdf
    font: verdana-11px-monochrome

  Label
    id: levelLabel
    anchors.left: nameLabel.right
    anchors.verticalCenter: parent.verticalCenter
    width: 60
    color: #dfdfdf
    font: verdana-11px-monochrome

  Label
    id: vocLabel
    anchors.left: levelLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    color: #dfdfdf
    font: verdana-11px-monochrome

MainWindow
  id: highscoreWindow
  !text: tr('Highscores')
  size: 620 560
  @onEscape: modules.game_highscore.toggle()

  Panel
    id: categoryPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 150
    margin-right: 6

    UIScrollArea
      id: categoryList
      anchors.fill: parent
      focusable: false
      layout:
        type: verticalBox
        spacing: 2

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: categoryPanel.right
    anchors.right: closeButton.left
    text-align: center
    font: verdana-11px-monochrome
    color: #ffd700
    text: Level

  Label
    id: headerLabel
    anchors.top: titleLabel.bottom
    anchors.left: categoryPanel.right
    anchors.right: parent.right
    margin-top: 6
    font: verdana-11px-monochrome
    color: #aaaaaa
    text: Rank        Name                                       Level   Vocation

  UIScrollArea
    id: resultList
    anchors.top: headerLabel.bottom
    anchors.left: categoryPanel.right
    anchors.right: parent.right
    anchors.bottom: pagePanel.top
    margin-top: 4
    margin-bottom: 6
    margin-right: 12
    padding: 1
    focusable: false
    vertical-scrollbar: resultScrollBar
    layout:
      type: verticalBox
      spacing: 1

  VerticalScrollBar
    id: resultScrollBar
    anchors.top: resultList.top
    anchors.right: parent.right
    anchors.bottom: resultList.bottom
    step: 28
    pixel-scroll: true

  Panel
    id: pagePanel
    anchors.left: categoryPanel.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26

    Button
      id: prevPageButton
      anchors.left: parent.left
      width: 64
      !text: tr('Previous')
      @onClick: modules.game_highscore.previousPage()

    Label
      id: pageLabel
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      text: Page 1 / 1
      font: verdana-11px-monochrome

    Button
      id: nextPageButton
      anchors.right: parent.right
      width: 64
      !text: tr('Next')
      @onClick: modules.game_highscore.nextPage()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.top: parent.top
    anchors.right: parent.right
    width: 60
    image-color: #cc3333
    @onClick: modules.game_highscore.toggle()
