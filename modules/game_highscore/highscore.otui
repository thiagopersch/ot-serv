HighscoreCategoryButton < Button
  height: 24
  anchors.left: parent.left
  anchors.right: parent.right
  text-align: left
  $on:
    color: #55ff55

HighscoreRow < Label
  height: 20
  padding: 2
  color: #dfdfdf
  background-color: alpha
  font: verdana-11px-monochrome

  $hover:
    background-color: #ffffff11

MainWindow
  id: highscoreWindow
  !text: tr('Highscores')
  size: 620 560
  @onEscape: modules.game_highscore.toggle()

  Panel
    id: categoryPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 150
    margin-right: 6

    UIScrollArea
      id: categoryList
      anchors.fill: parent
      focusable: false
      layout:
        type: verticalBox
        spacing: 2

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: categoryPanel.right
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    color: #ffd700
    text: Level

  Label
    id: headerLabel
    anchors.top: titleLabel.bottom
    anchors.left: categoryPanel.right
    anchors.right: parent.right
    margin-top: 6
    font: verdana-11px-monochrome
    color: #aaaaaa
    text: Rank                Name                          Vocation            Value

  TextList
    id: resultList
    anchors.top: headerLabel.bottom
    anchors.left: categoryPanel.right
    anchors.right: parent.right
    anchors.bottom: pagePanel.top
    margin-top: 4
    margin-bottom: 6
    padding: 1
    focusable: false

  Panel
    id: pagePanel
    anchors.left: categoryPanel.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26

    Button
      id: prevPageButton
      anchors.left: parent.left
      width: 64
      !text: tr('Previous')
      @onClick: modules.game_highscore.previousPage()

    Label
      id: pageLabel
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      text: Page 1 / 1
      font: verdana-11px-monochrome

    Button
      id: nextPageButton
      anchors.right: parent.right
      width: 64
      !text: tr('Next')
      @onClick: modules.game_highscore.nextPage()
