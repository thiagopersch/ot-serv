UIWindow
  id: vocWindow
  size: 720 380
  text: Change Vocation
  closeable: true
  background-color: #000000cc

  Panel
    id: leftPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 180
    background-color: #1a1a1a

    Creature
      id: charPortrait
      size: 90 90
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20

    Label
      id: charName
      anchors.top: charPortrait.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      text: Name
      color: #ffffff

    Label
      id: charClass
      anchors.top: charName.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text: Class
      color: #cccccc

    Label
      id: charType
      anchors.top: charClass.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text: Type
      color: #cccccc

    Label
      id: charElement
      anchors.top: charType.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text: Element
      color: #cccccc

    Button
      id: confirmButton
      text: Confirm
      width: 80
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-bottom: 10

  Panel
    id: centerPanel
    anchors.top: parent.top
    anchors.left: leftPanel.right
    anchors.bottom: parent.bottom
    anchors.right: rightPanel.left
    margin-left: 10
    margin-right: 10

    UIScrollArea
      id: vocList
      anchors.fill: parent
      vertical: true
      margin: 8

  Panel
    id: rightPanel
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 180
    background-color: #2a2a2acc

    Label
      id: filtersLabel
      text: Filters
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      color: #ffffff

    Label
      id: classLabel
      text: Class:
      anchors.top: filtersLabel.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 10
      color: #cccccc

    CheckBox
      id: filterShinigami
      text: Shinigami
      anchors.top: classLabel.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    CheckBox
      id: filterQuincy
      text: Quincy
      anchors.top: filterShinigami.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    CheckBox
      id: filterHollow
      text: Hollow
      anchors.top: filterQuincy.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    CheckBox
      id: filterHumano
      text: Humano
      anchors.top: filterHollow.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    Label
      id: typeLabel
      text: Type:
      anchors.top: filterHumano.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 10
      color: #cccccc

    CheckBox
      id: filterDanoPvp
      text: Dano Pvp
      anchors.top: typeLabel.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    CheckBox
      id: filterDanoPve
      text: Dano Pve
      anchors.top: filterDanoPvp.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    CheckBox
      id: filterSupport
      text: Support
      anchors.top: filterDanoPve.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    CheckBox
      id: filterTank
      text: Tank
      anchors.top: filterSupport.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

  VocItem < Panel
    height: 90
    margin-bottom: 8
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Creature
      id: outfitView
      size: 60 60
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10

    Label
      id: vocName
      anchors.left: outfitView.right
      anchors.top: parent.top
      margin-left: 12
      margin-top: 12
      text: Vocation Name
      color: #ffffff

    Label
      id: vocClass
      anchors.left: outfitView.right
      anchors.top: vocName.bottom
      margin-left: 12
      margin-top: 5
      text: Class
      color: #cccccc

    Label
      id: vocType
      anchors.left: outfitView.right
      anchors.top: vocClass.bottom
      margin-left: 12
      margin-top: 5
      text: Type
      color: #cccccc

    Label
      id: vocElement
      anchors.left: outfitView.right
      anchors.top: vocType.bottom
      margin-left: 12
      margin-top: 5
      text: Element
      color: #cccccc
