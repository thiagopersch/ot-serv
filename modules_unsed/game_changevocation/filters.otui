MainWindow
  id: filtersWindow
  !text: tr("Filters")
  size: 220 200
  color: white
  font: verdana-11px-rounded
  padding-top: 30
  padding-bottom: 10
  &static: true

  HorizontalSeparator
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    Label
      !text: tr("Class")
      text-auto-resize: true
      font: verdana-11px-rounded
      color: white
      anchors.centerIn: parent

  Panel
    id: classPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 15
    layout:
      type: grid
      flow: true
      cell-size: 90 15
      cell-spacing: 3
      fit-children: true
    CheckBox
      id: 1
      !text: tr("Shinigami")
      text-auto-resize: true
      font: verdana-11px-rounded
    CheckBox
      id: 2
      !text: tr("Hollow")
      text-auto-resize: true
      font: verdana-11px-rounded
    CheckBox
      id: 3
      !text: tr("Quincy")
      text-auto-resize: true
      font: verdana-11px-rounded
    CheckBox
      id: 4
      !text: tr("Humano")
      text-auto-resize: true
      font: verdana-11px-rounded

  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 20
    Label
      !text: tr("Type")
      text-auto-resize: true
      font: verdana-11px-rounded
      color: white
      anchors.centerIn: parent

  Panel
    id: typePanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 15
    layout:
      type: grid
      flow: true
      cell-size: 90 15
      cell-spacing: 3
      fit-children: true
    CheckBox
      id: 1
      !text: tr("Dano Pvp")
      text-auto-resize: true
      font: verdana-11px-rounded
    CheckBox
      id: 2
      !text: tr("Dano pve")
      text-auto-resize: true
      font: verdana-11px-rounded
    CheckBox
      id: 3
      !text: tr("Support")
      text-auto-resize: true
      font: verdana-11px-rounded
    CheckBox
      id: 4
      !text: tr("Tank")
      text-auto-resize: true
      font: verdana-11px-rounded

  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 20
    Label
      text-auto-resize: true
      font: verdana-11px-rounded
      color: white
      anchors.centerIn: parent

  Panel
    id: elementPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 15
    layout:
      type: grid
      flow: true
      cell-size: 90 15
      cell-spacing: 3
      fit-children: true
