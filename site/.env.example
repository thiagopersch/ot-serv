# Banco de dados (credenciais do ../compose.yaml — serviço db, container ndbo-db)
DATABASE_URL="mysql://user:password@localhost:3306/ndbo"

# next-auth (Auth.js v5) — lidos automaticamente via process.env.NEXTAUTH_*
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Seed inicial (prisma/seed.ts) — conta admin do portal (group_id=6)
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_EMAIL=""

# SMTP para e-mail de recuperação de conta (lib/mailer.ts).
# Deixe em branco em desenvolvimento: o envio é ignorado (com aviso no log) sem quebrar o fluxo.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@ndbo.local"

# Probe TCP na porta de login do OTServer (config.lua `loginPort`) usado para o badge de
# "servidor online/fechado" (lib/game-server-status.ts). Padrão: 127.0.0.1:7171.
GAME_SERVER_HOST="127.0.0.1"
GAME_SERVER_LOGIN_PORT=7171

# Pasta `data/` do servidor OTServer C++ (mesma máquina) — usado pelo CRUD de NPCs
# (app/api/admin/npcs) para gravar os arquivos data/npc/{name}.xml e
# data/npc/scripts/{name}.lua gerados a partir do que é configurado no admin.
OTSERVER_DATA_PATH="C:/caminho/para/o/servidor/data"

# Raiz do diretório do servidor (opcional) — usada pelo Explorador de arquivos do servidor
# (/admin/lua-scripts/explorer, lib/server-files.ts). Se omitida, é derivada automaticamente
# do diretório pai de OTSERVER_DATA_PATH (ex.: "C:/.../server/data" -> "C:/.../server").
OTSERVER_ROOT_PATH=""
