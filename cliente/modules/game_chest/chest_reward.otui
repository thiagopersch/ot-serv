MainWindow
  id: chestRewardWindow
  !text: tr('Chest opened!')
  size: 280 160
  @onEscape: destroy()

  UIItem
    id: rewardIcon
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    size: 32 32
    virtual: true

  Label
    id: rewardLabel
    anchors.top: rewardIcon.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    margin-right: 10
    text-align: center
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #ffd700

  Button
    !text: tr('Nice!')
    anchors.top: rewardLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    width: 80
    @onClick: modules.game_chest.closeRewardPopup()
