SkillRow < UIWidget
  height: 30
  padding: 5
  color: #aaaaaa
  background-color: alpha
  border-width: 1
  border-color: alpha
  focusable: true

  $hover:
    background-color: #ffffff11

  $focus:
    background-color: #ffffff22
    border-color: #ffffff55
    color: #ffffff

  Label
    id: name
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    font: verdana-11px-monochrome

  Label
    id: value
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #55ffff

  Label
    id: level
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #ffd700

GroupHeader < UIWidget
  height: 22
  padding: 4
  background-color: #333355
  border-width: 1
  border-color: #555588
  focusable: false

  Label
    id: label
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #88aaff

MainWindow
  id: skillUpgradesWindow
  !text: tr('Skill Upgrades')
  size: 760 650
  @onEscape: modules.game_skill_upgrades.toggle()

  Label
    id: pointsLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 6
    margin-left: 6
    text-auto-resize: true
    text: Available Points: 0
    color: #55ff55
    font: verdana-11px-monochrome

  Label
    id: spentLabel
    anchors.top: prev.top
    anchors.right: parent.right
    margin-right: 6
    text-auto-resize: true
    text: Spent Points: 0
    color: #ff5555
    font: verdana-11px-monochrome

  UIScrollArea
    id: skillsList
    anchors.top: pointsLabel.bottom
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    margin-top: 8
    margin-left: 6
    margin-bottom: 6
    width: 360
    focusable: false
    vertical-scrollbar: skillsScroll
    layout:
      type: verticalBox
      spacing: 2

  VerticalScrollBar
    id: skillsScroll
    anchors.top: skillsList.top
    anchors.bottom: skillsList.bottom
    anchors.left: skillsList.right
    step: 14
    pixels-scroll: true

  Panel
    id: detailPanel
    anchors.top: skillsList.top
    anchors.left: skillsScroll.right
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-left: 10
    margin-right: 6
    margin-bottom: 6

    Label
      id: skillTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      text-align: center
      font: verdana-11px-monochrome
      color: #ffffff
      text: Select a skill

    Label
      id: skillDesc
      anchors.top: skillTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      text-wrap: true
      text-auto-resize: true
      color: #aaaaaa
      text:

    Label
      id: skillStats
      anchors.top: skillDesc.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      text-wrap: true
      text-auto-resize: true
      color: #ffff55
      text:

    Label
      id: upgradeCost
      anchors.top: skillStats.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      text-auto-resize: true
      color: #ffaa55
      text:

    Button
      id: upgradeButton
      anchors.bottom: resetButton.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 5
      text: Upgrade Skill
      !tooltip: tr('Spend points to upgrade this skill.')
      @onClick: modules.game_skill_upgrades.doUpgrade()

    Button
      id: resetButton
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      text: Reset All Skills
      color: #ff5555
      !tooltip: tr('Reset all skills and refund points.')
      @onClick: modules.game_skill_upgrades.doReset()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 6
    width: 100
    image-color: #cc3333
    @onClick: modules.game_skill_upgrades.toggle()
