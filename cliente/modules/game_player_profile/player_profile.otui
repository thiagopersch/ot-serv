MainWindow
  id: inspectWindow
  !text: tr("Profile")
  font: verdana-11px-rounded
  color: white
  size: 500 680
  minimum-size: 500 680
  maximum-size: 500 680
  @onEscape: modules.game_player_profile.close()
  @onEnter: modules.game_player_profile.search()

  Panel
    id: leftColumn
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 240
    layout:
      type: verticalBox

    Panel
      id: rankPanel
      !text: tr("Rank")
      text-align: top
      text-offset: 0 2
      color: #ffd700
      font: verdana-11px-rounded
      size: 240 120
      background-color: #0000007f
      border-width: 1
      border-color: black
      border-color-right: #7b7b7b
      border-color-bottom: #7b7b7b

      Label
        id: rankLabel
        text-auto-resize: true
        font: verdana-11px-rounded
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 22

      Label
        id: pointsLabel
        text-auto-resize: true
        font: verdana-11px-rounded
        anchors.top: prev.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2

      Label
        id: nextRankLabel
        text-auto-resize: true
        font: verdana-11px-rounded
        color: #aaaaaa
        anchors.top: prev.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2

      Panel
        id: rankProgressBar
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 5
        margin-right: 5
        height: 10
        image-source: /images/ui/panel_flat
        image-border: 1
        background-color: #333333

        Panel
          id: rankProgressFill
          image-source: /images/ui/panel_flat
          image-color: #ffd700
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.bottom: parent.bottom
          width: 0

      Label
        id: rankProgressText
        text-auto-resize: true
        font: verdana-11px-rounded
        color: #888888
        anchors.top: rankProgressBar.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2

    Panel
      id: playerPanel
      !text: tr("Player")
      text-align: top
      text-offset: 0 2
      color: orange
      font: verdana-11px-rounded
      background-color: #0000007f
      border-width: 1
      border-color: black
      border-color-right: #7b7b7b
      border-color-bottom: #7b7b7b
      margin-top: 5
      width: 240
      height: 480

      UIWidget
        id: vocationImage
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 20
        size: 96 96
        image-source: /images/vocations/not_found
        phantom: true

      Panel
        id: eloInfo
        anchors.top: vocationImage.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        height: 1
        phantom: false

      Label
        id: nameLabel
        anchors.top: eloInfo.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        text-auto-resize: true
        color: white
        font: terminus-14px-bold
        margin-top: 6

      HealthBar
        id: healthBar
        width: 120
        anchors.top: nameLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        phantom: true

      ManaBar
        id: manaBar
        width: 120
        anchors.top: healthBar.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        phantom: true

      Label
        id: levelLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: manaBar.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: vocationLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: levelLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: ageLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: vocationLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: fragsLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: ageLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: resetsLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: fragsLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: onlinePointsLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: resetsLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: balanceLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: onlinePointsLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: capLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: balanceLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: accountLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: capLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: townLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: accountLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: guildLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: townLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: staminaLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: guildLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      Label
        id: donateTierLabel
        font: verdana-11px-rounded
        text-auto-resize: true
        anchors.top: staminaLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3

      ProgressBar
        id: staminaBar
        width: 120
        anchors.top: donateTierLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3
        background-color: #3bd309
        phantom: true

  TextEdit
    id: searchEdit
    max-length: 30
    width: 150
    !placeholder: tr("Player name...")
    placeholder-color: #2929299f
    icon: assets/search
    icon-align: left
    icon-size: 14 14
    icon-offset: 4 4
    padding-left: 22
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-bottom: 10
    margin-right: 70

  Button
    id: searchButton
    !text: tr("Search")
    anchors.top: searchEdit.top
    anchors.left: searchEdit.right
    anchors.right: parent.right
    margin-left: 5
    @onClick: modules.game_player_profile.search()

  Panel
    id: itemsPanel
    !text: tr("Items")
    text-align: top
    text-offset: 0 2
    color: orange
    font: verdana-11px-rounded
    size: 220 180
    background-color: #0000007f
    border-width: 1
    border-color: black
    border-color-right: #7b7b7b
    border-color-bottom: #7b7b7b
    anchors.top: searchEdit.bottom
    anchors.right: parent.right
    margin-top: 10

    Panel
      id: eyeIcon
      image-source: assets/eye_open
      !tooltip: tr("Esconder Items/Mostrar Items")
      anchors.top: parent.top
      anchors.left: parent.left
      margin: 8
      change-cursor-image: true
      cursor: pointer
      phantom: false
      @onClick: modules.game_player_profile.changePrivacy()

    HeadSlot
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 25
      virtual: true
      phantom: true

    BodySlot
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter
      margin-top: 3
      virtual: true
      phantom: true

    LegSlot
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter
      margin-top: 3
      virtual: true
      phantom: true

    FeetSlot
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter
      margin-top: 3
      virtual: true
      phantom: true

    NeckSlot
      anchors.top: slot1.top
      anchors.right: slot1.left
      margin-top: 13
      margin-right: 5
      virtual: true
      phantom: true

    LeftSlot
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter
      margin-top: 3
      virtual: true
      phantom: true

    FingerSlot
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter
      margin-top: 3
      virtual: true
      phantom: true

    BackSlot
      anchors.top: slot1.top
      anchors.left: slot1.right
      margin-top: 13
      margin-left: 5
      virtual: true
      phantom: true

    RightSlot
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter
      margin-top: 3
      virtual: true
      phantom: true

    AmmoSlot
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter
      margin-top: 3
      virtual: true
      phantom: true

  Panel
    id: skillsPanel
    !text: tr("Skills")
    text-align: top
    text-offset: 0 2
    color: orange
    font: verdana-11px-rounded
    size: 160 200
    background-color: #0000007f
    border-width: 1
    border-color: black
    border-color-right: #7b7b7b
    border-color-bottom: #7b7b7b
    anchors.top: itemsPanel.bottom
    anchors.horizontalCenter: itemsPanel.horizontalCenter
    margin-top: 10

    Label
      id: magLevel
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 30

    Label
      id: skill0
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter

    Label
      id: skill1
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter

    Label
      id: skill2
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter

    Label
      id: skill3
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter

    Label
      id: skill4
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter

    Label
      id: skill5
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter

    Label
      id: skill6
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: prev.horizontalCenter

    Panel
      id: skillDivider
      height: 1
      background-color: #ffffff33
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5 10 0 10

    Label
      id: dodgeLabel
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5

    Label
      id: critLabel
      text-auto-resize: true
      font: verdana-11px-rounded
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2

  Button
    id: closeButton
    !text: tr("Close")
    width: 56
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 10
    @onClick: modules.game_player_profile.close()
